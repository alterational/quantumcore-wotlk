ms":0,"gcd_ms":0,"duration_ms":0,"proc_chance":30,"proc_charges":0,"targets":16},"57978":{"id":57978,"icon":"inv_misc_herb_16","name":{"en":"Wound Poison VII","ru":"Нейтрализующий яд VII"},"rank":{"en":"Rank 7","ru":"Уровень 7"},"text":{"en":"Coats a weapon with poison that lasts for 1 hour.\nEach strike has a chance of poisoning the enemy, causing Nature damage and reducing all healing effects used on them by -50% for 15 sec.","ru":"Покрывает оружие ядом, действующим в течение 1 часа. У каждого удара появляется шанс отравить противника и мгновенно нанести ед. урона от сил природы и снижая эффективность любого лечения цели на -50% в течение 15 сек."},"cooldown_ms":0,"gcd_ms":0,"duration_ms":0,"proc_chance":50,"proc_charges":0,"targets":16},"57982":{"id":57982,"icon":"spell_nature_slowpoison","name":{"en":"Anesthetic Poison II","ru":"Анестезирующий яд II"},"rank":{"en":"Rank 2","ru":"Уровень 2"},"text":{"en":"Coats a weapon with poison that lasts for 1 hour. Each strike has a % chance of poisoning the enemy which instantly inflicts 218-280 Nature damage and dispels 1 Enrage effect, but causes no additional threat.","ru":"Покрывает оружие ядом, действующим в течение 1 часа. Каждый удар с %-й вероятностью отравляет противника, мгновенно нанося 218-280 ед. урона от сил природы и рассеивая 1 эффектов исступления. Не повышает уровень угрозы."},"cooldown_ms":0,"gcd_ms":0,"duration_ms":0,"proc_chance":50,"proc_charges":0,"targets":16}},"sets":{}}